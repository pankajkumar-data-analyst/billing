# =============================================================================
# One2Infinite Internal App — Environment Variables
# Copy to `.env.local` for local dev. In production, set these in Vercel.
# NEVER commit real values. This file documents the keys only.
# =============================================================================

# --- Database (Neon / managed Postgres) ---
# Pooled connection string used by the app at runtime.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require&pgbouncer=true"
# Direct connection string used by Prisma migrations (no pooling).
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"

# --- Auth.js (NextAuth) ---
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-secret"
# Public base URL of the app. Locally http://localhost:3000; in prod https://app.one2infinite.com
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"

# --- File storage (Phase 1: optional) ---
# Vercel Blob token (private storage). Leave blank in dev to use local ./uploads.
BLOB_READ_WRITE_TOKEN=""

# --- Seed / bootstrap admin (used only by `npm run db:seed`) ---
# The first Super Admin account. Change the password immediately after first login.
SEED_ADMIN_EMAIL="admin@one2infinite.com"
SEED_ADMIN_PASSWORD="ChangeMe!2026"
SEED_ADMIN_NAME="Pankaj Kumar"

# --- App environment ---
NODE_ENV="development"

# --- Cron (Vercel) ---
# Vercel sends `Authorization: Bearer <CRON_SECRET>` to cron routes.
CRON_SECRET=""

# --- Demo data ---
# Set to 1 to seed fictional demo data (clients/jobs/candidates/etc.).
SEED_DEMO="0"
